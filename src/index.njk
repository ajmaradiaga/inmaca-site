---
layout: layouts/base.njk
---

{% include "partials/topbar.njk" %}

{% include "partials/header.njk" %}

<!-- ===== Hero ===== -->
<section id="inicio" class="hero">
  <div class="wrap hero__inner hero__inner--2col">
    <div class="hero__img-col">
      <img src="/assets/img/inmaca.jpg" alt="{{ site.company }}" class="hero__logo-img">
    </div>
    <div class="hero__content-col">
      <h1 class="hero__title">{{ site.company }}</h1>
      <p class="hero__lead">{{ site.tagline }}</p>
      <a href="#proyectos" class="btn btn--accent">Ver nuestros proyectos</a>
    </div>
  </div>
</section>

<!-- ===== About ===== -->
<section id="empresa" class="about">
  <br/>
  <div class="wrap grid grid--2">
    <div>
      <h2 class="section-title">INMACA</h2>
      <h3>Quiénes somos</h3>
      <p>{{ site.about.quienes }}</p>
      <!--h3>Misión</h3>
      <p>{{ site.about.mision }}</p>
      <h3>Visión</h3>
      <p>{{ site.about.vision }}</p-->
    </div>
    <div class="stats">
      {% for stat in site.stats %}
      <div class="stat">
        <span class="stat__value">{{ stat.value }}</span>
        <span class="stat__label">{{ stat.label }}</span>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<!-- ===== Projects ===== -->
<section id="proyectos" class="projects">
  <br/>
  <div class="wrap">
    <h2 class="section-title">Proyectos</h2>
    <div class="grid grid--3">
      {% for p in site.projects %}
      <article class="project" role="button" tabindex="0" aria-label="Ver descripción de {{ p.name }}">
        <div class="project__inner">
          <div class="project__front">
            <div class="project__img" style="background-image:url('{{ p.image }}')"></div>
            <div class="project__body">
              <h3>{{ p.name }}</h3>
              {% if p.location %}<p>{{ p.location }}</p>{% endif %}
            </div>
          </div>
          <div class="project__back">
            <h3>{{ p.name }}</h3>
            {% if p.location %}<p class="project__back-location">{{ p.location }}</p>{% endif %}
            {% if p.desc %}<p class="project__back-desc">{{ p.desc }}</p>{% endif %}
          </div>
        </div>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

<!-- ===== Services ===== -->
<section class="services">
  <br/>
  <div class="wrap">
    <h2 class="section-title">Nuestros servicios</h2>
    <div class="grid grid--4">
      {% for s in site.services %}
      <article class="service">
        <div class="service__icon"><i data-lucide="{{ s.icon }}"></i></div>
        <h2>{{ s.title }}</h2>
        <br/>
        <p>{{ s.desc }}</p>
      </article>
      {% endfor %}
    </div>
    <div class="cta-band">
      <p>¿Desea contactarnos?</p>
      <a href="#contacto" class="btn btn--ghost">Contactenos</a>
    </div>
  </div>
</section>

<!-- ===== Members / Nosotros ===== -->
<section id="nosotros" class="members">
  <br/>
  <div class="wrap">
    <h2 class="section-title">Nosotros</h2>
    <div class="grid grid--2 members__grid">
      {% for m in site.team %}
      <article class="member-card">
        <div class="member-card__photo" style="background-image:url('{{ m.photo }}')"></div>
        <div class="member-card__body">
          <h3>{{ m.name }}</h3>
          <p class="member-card__title">{{ m.title }}</p>
          <p class="member-card__bio">{{ m.bio }}</p>
          <a href="/equipo/{{ m.slug }}/" class="btn btn--accent member-card__cta">Ver perfil completo</a>
        </div>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

<!-- ===== Rental equipment ===== -->
