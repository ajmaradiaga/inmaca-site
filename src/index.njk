<!-- ===== Divider ===== -->
<div class="divider">
  <div class="wrap divider__inner">
    <span class="divider__line"></span>
    <span class="divider__icon"><i data-lucide="phone"></i></span>
    <span class="divider__icon"><i data-lucide="mail"></i></span>
    <span class="divider__line"></span>
  </div>
</div>

<!-- ===== Contact ===== -->
<section id="contacto" class="contact">
  <div class="wrap grid grid--2">
    <div>
      <h2 class="section-title">Contáctenos</h2>
      <form action="https://formspree.io/f/{{ site.formspreeId }}" method="POST" class="form">
        <input type="text" name="nombre" placeholder="Nombre" required>
        <input type="email" name="email" placeholder="Correo electrónico" required>
        <input type="tel" name="telefono" placeholder="Teléfono">
        <textarea name="mensaje" rows="5" placeholder="Déjenos un mensaje" required></textarea>
        <button type="submit" class="btn btn--accent">Enviar mensaje</button>
      </form>
    </div>
    <div class="contact__info">
      <h3>Teléfono</h3>
      <p class="contact__phone">{{ site.phone }}</p>
      <h3>Dirección</h3>
      <p>{{ site.address }}</p>
      <h3>Correo</h3>
      <p>{{ site.email }}</p>
    </div>
  </div>
</section>

{% include "partials/footer.njk" %}

<script>
  document.querySelectorAll('.project').forEach(function(card) {
    function toggle() { card.classList.toggle('is-flipped'); }
    card.addEventListener('click', toggle);
    card.addEventListener('keydown', function(e) {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggle(); }
    });
  });
</script>
