---
layout: layouts/base.njk
permalink: /equipo/carlos/
---

{% set member = site.team[0] %}

<!-- ===== Top bar ===== -->
<div class="topbar">
  <div class="wrap topbar__inner">
    <span>{{ site.phone }} &nbsp;·&nbsp; {{ site.email }}</span>
    <nav class="social">
      <a href="{{ site.social.facebook }}" aria-label="Facebook">FB</a>
      <a href="{{ site.social.instagram }}" aria-label="Instagram">IG</a>
      <a href="{{ site.social.linkedin }}" aria-label="LinkedIn">IN</a>
    </nav>
  </div>
</div>

<!-- ===== Header / nav ===== -->
<header class="header">
  <div class="wrap header__inner">
    <a href="/" class="logo">{{ site.company }}</a>
    <nav class="nav">
      <a href="/">Inicio</a>
      <a href="/#empresa">Nuestra Empresa</a>
      <a href="/#proyectos">Proyectos</a>
      <a href="/#nosotros">Nosotros</a>
      <a href="/#equipo">Alquiler de equipo</a>
      <a href="/#contacto">Contáctenos</a>
    </nav>
  </div>
</header>

<!-- ===== Profile ===== -->
<section class="profile">
  <div class="wrap profile__inner">
    <a href="/#nosotros" class="profile__back">← Volver</a>
    <div class="profile__hero">
      <div class="profile__photo" style="background-image:url('{{ member.photo }}')"></div>
      <div class="profile__header">
        <p class="profile__label">{{ member.title }}</p>
        <h1 class="profile__name">{{ member.name }}</h1>
        <p class="profile__bio">{{ member.bio }}</p>
      </div>
    </div>
    <div class="profile__body">
      <h2>Experiencia destacada</h2>
      <ul class="profile__list">
        {% for item in member.experience %}
        <li>{{ item }}</li>
        {% endfor %}
      </ul>
    </div>
  </div>
</section>

<!-- ===== Footer ===== -->
<footer class="footer">
  <div class="wrap">
    <p>&copy; 2026 {{ site.company }}. Todos los derechos reservados.</p>
  </div>
</footer>
